{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"enableAllProjectMcpServers": true,
	"permissions": {
		"defaultMode": "bypassPermissions",
		"allow": [
			"Bash(codex --version)",
			"Bash(codex login *)",
			"Bash(codex login status)",
			"Bash(codex exec *)",
			"Bash(agent.cmd --version)",
			"Bash(git status *)",
			"Bash(git log *)",
			"Bash(git show *)",
			"Bash(git diff *)",
			"Bash(mkdir *)",
			"Bash(mkdir -p tmp/*)",
			"Read(//tmp/**)",
			"Bash(npm view *)",
			"Bash(npm ci)",
			"Bash(node_modules/.bin/scaffold audit *)",
			"Bash(npx scaffold audit *)",
			"Bash(npx vitest run *)",
			"Bash(npx tsc --noEmit *)",
			"Bash(npm test)",
			"Bash(npm test *)",
			"Bash(npm run clean)",
			"Bash(npm run check)",
			"Bash(npm run check *)",
			"Bash(npm run check:src)",
			"Bash(npm run check:src *)",
			"Bash(npm run check:src:core)",
			"Bash(npm run check:src:core *)",
			"Bash(npm run check:app)",
			"Bash(npm run check:app *)",
			"Bash(npm run check:app:core)",
			"Bash(npm run check:app:core *)",
			"Bash(npm run check:app:browser)",
			"Bash(npm run check:app:browser *)",
			"Bash(npm run lint)",
			"Bash(npm run lint *)",
			"Bash(npm run lint:check)",
			"Bash(npm run lint:check *)",
			"Bash(npm run format)",
			"Bash(npm run format *)",
			"Bash(npm run format:check)",
			"Bash(npm run format:check *)",
			"Bash(npm run test)",
			"Bash(npm run test *)",
			"Bash(npm run test:src)",
			"Bash(npm run test:src *)",
			"Bash(npm run test:src:core)",
			"Bash(npm run test:src:core *)",
			"Bash(npm run test:app)",
			"Bash(npm run test:app *)",
			"Bash(npm run test:app:core)",
			"Bash(npm run test:app:core *)",
			"Bash(npm run test:app:browser)",
			"Bash(npm run test:app:browser *)",
			"Bash(npm run test:policy)",
			"Bash(npm run test:policy *)",
			"Bash(npm run test:config)",
			"Bash(npm run test:config *)",
			"Bash(npm run test:guides)",
			"Bash(npm run test:guides *)",
			"Bash(npm run test:conformance)",
			"Bash(npm run test:conformance *)",
			"Bash(npm run test:integration)",
			"Bash(npm run test:integration *)",
			"Bash(npm run test:distribution)",
			"Bash(npm run test:distribution *)",
			"Bash(npm run test:probe)",
			"Bash(npm run test:probe *)",
			"Bash(npm run build)",
			"Bash(npm run build *)",
			"Bash(npm run build:src)",
			"Bash(npm run build:src *)",
			"Bash(npm run build:src:core)",
			"Bash(npm run build:src:core *)",
			"Bash(npm run build:app)",
			"Bash(npm run build:app *)",
			"Bash(npm run build:app:browser)",
			"Bash(npm run build:app:browser *)",
			"mcp__codex__codex",
			"mcp__codex__codex-reply",
			"mcp__webstorm__read_file",
			"mcp__webstorm__search_regex",
			"mcp__webstorm__search_text",
			"mcp__webstorm__search_file",
			"mcp__webstorm__search_symbol",
			"mcp__webstorm__get_file_problems",
			"mcp__webstorm__get_symbol_info",
			"mcp__webstorm__get_project_modules",
			"mcp__webstorm__get_all_open_file_paths",
			"mcp__webstorm__lint_files",
			"mcp__webstorm__git_status",
			"mcp__webstorm__list_directory_tree"
		],
		"deny": [
			"Read(.env*)",
			"Read(**/.env*)",
			"Read(.npmrc)",
			"Read(**/.npmrc)",
			"Read(.pypirc)",
			"Read(**/.pypirc)",
			"Read(.netrc)",
			"Read(**/.netrc)",
			"Read(.git-credentials)",
			"Read(**/.git-credentials)",
			"Read(auth.json)",
			"Read(**/auth.json)",
			"Read(credentials)",
			"Read(**/credentials)",
			"Read(credentials.json)",
			"Read(**/credentials.json)",
			"Read(application_default_credentials.json)",
			"Read(**/application_default_credentials.json)",
			"Read(*.pem)",
			"Read(**/*.pem)",
			"Read(*.key)",
			"Read(**/*.key)",
			"Read(*.p12)",
			"Read(**/*.p12)",
			"Read(*.pfx)",
			"Read(**/*.pfx)",
			"Read(*.pkcs12)",
			"Read(**/*.pkcs12)",
			"Read(*.jks)",
			"Read(**/*.jks)",
			"Read(id_rsa)",
			"Read(**/id_rsa)",
			"Read(id_ed25519)",
			"Read(**/id_ed25519)",
			"Read(.aws/credentials)",
			"Read(**/.aws/credentials)",
			"Read(.ssh/**)",
			"Read(**/.ssh/**)",
			"Read(.aws/**)",
			"Read(**/.aws/**)",
			"Read(.azure/**)",
			"Read(**/.azure/**)",
			"Read(.kube/**)",
			"Read(**/.kube/**)",
			"Read(.gnupg/**)",
			"Read(**/.gnupg/**)",
			"Read(.docker/config.json)",
			"Read(**/.docker/config.json)",
			"Read(kubeconfig)",
			"Read(**/kubeconfig)",
			"Read(.config/gh/**)",
			"Read(**/.config/gh/**)",
			"Read(.config/gcloud/**)",
			"Read(**/.config/gcloud/**)",
			"Read(.local/share/keyrings/**)",
			"Read(**/.local/share/keyrings/**)",
			"Read(*service-account*.json)",
			"Read(**/*service-account*.json)",
			"Read(//**/.env)",
			"Read(//**/.env.*)",
			"Read(//**/.npmrc)",
			"Read(//**/auth.json)",
			"Read(//**/.pypirc)",
			"Read(//**/.netrc)",
			"Read(//**/.git-credentials)",
			"Read(//**/credentials)",
			"Read(//**/credentials.json)",
			"Read(//**/application_default_credentials.json)",
			"Read(//**/*.pem)",
			"Read(//**/*.key)",
			"Read(//**/*.p12)",
			"Read(//**/*.pfx)",
			"Read(//**/*.pkcs12)",
			"Read(//**/*.jks)",
			"Read(//**/id_rsa)",
			"Read(//**/id_ed25519)",
			"Read(//**/.ssh/**)",
			"Read(//**/.aws/**)",
			"Read(//**/.azure/**)",
			"Read(//**/.kube/**)",
			"Read(//**/.gnupg/**)",
			"Read(//**/.docker/config.json)",
			"Read(//**/kubeconfig)",
			"Read(//**/.config/gh/**)",
			"Read(//**/.config/gcloud/**)",
			"Read(//**/.local/share/keyrings/**)",
			"Read(//**/*service-account*.json)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/deps.sh",
						"timeout": 600
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/ollama.sh",
						"timeout": 600
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/cursor.sh",
						"timeout": 120
					},
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/codex.sh",
						"timeout": 120
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "git -C \"${CLAUDE_PROJECT_DIR}\" diff --check",
						"timeout": 30
					}
				]
			}
		]
	}
}
